<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="invoice_form_view_inherit" model="ir.ui.view">
        <field name="name">invoice.form.view.inherit2</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <widget name="web_ribbon" title="Draft" invisible="state != 'draft'"/>
                <widget name="web_ribbon" title="Posted" invisible="state != 'posted'"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="attributes">
                <attribute name="options">{'always_reload' : True, 'no_quick_create': True, 'no_create_edit' : True}</attribute>
            </xpath>
            <xpath expr="//page[@name='invoice_tab']//field[@name='product_id']" position="attributes">
                <attribute name="options">{'always_reload' : True, 'no_quick_create': True, 'no_create_edit' : True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>