<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.view.inherit2</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']//field[@name='warehouse_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="warehouse_id" />
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="inside">
                <button name="open_wizard" type="object" class="btn-primary" string="Add Products"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//field[@name='team_id']" position="after">
                <field name="service_product"/>
            </xpath>
            <xpath expr="//button[@name='action_preview_sale_order']" position="after">
                <button name="action_approval"
                    type="object"
                    string="Approve"
                    class="btn-primary"
                    invisible = "state not in ('to_approve')" groups="practical_archi.group_sale_approver"/>
            </xpath>
        </field>
    </record>
</odoo>