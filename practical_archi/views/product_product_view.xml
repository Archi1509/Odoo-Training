<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_product_form_view_inherit2" model="ir.ui.view">
        <field name="name">product.product.form.view.inherit2</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='default_code']" position="after">
                <field name="pharmacy_ids"/>
            </xpath>
        </field>
    </record>
    <record id="product_product_search_view_inherit" model="ir.ui.view">
        <field name="name">product.product.search.view.inherit2</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">
            <field name="all_product_tag_ids" position="after">
                <field name="pharmacy_ids" string="Pharmacy"/>
            </field>
		</field>
    </record>
</odoo>
