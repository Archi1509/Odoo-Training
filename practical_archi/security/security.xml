<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.module.category" id="sale_pharmacy_groups">
             <field name="name">Sale Pharmacy</field>
             <field name="description">User access levels for Sale Pharmacy module</field>
             <field name="parent_id" ref="base.module_category_sales"/>
             <field name="sequence">10</field>
    </record>

    <record id="group_user_sale_pharmacy" model="res.groups">
        	<field name="name">Sale Pharmacy User</field>
            <field name="category_id" ref="sale_pharmacy_groups"/>
            <field name="comment">User Rights</field>
    </record>

    <record id="group_sale_approver" model="res.groups">
        	<field name="name">Sale Approver</field>
    </record>

    <record id="group_admin_sale_pharmacy" model="res.groups">
        	<field name="name">Sale Pharmacy Admin</field>
            <field name="category_id" ref="sale_pharmacy_groups"/>
            <field name="implied_ids" eval="[(4, ref('practical_archi.group_user_sale_pharmacy'))]"/>
            <field name="comment">Admin Rights</field>
    </record>

    <data noupdate="1">
        <record id="sale_pharmacy_user_rule" model="ir.rule">
            <field name="name">Sale Pharmacy Rule</field>
            <field name="model_id" ref="model_sale_pharmacy"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('practical_archi.group_user_sale_pharmacy'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>
        <record id="sale_pharmacy_user_rule" model="ir.rule">
            <field name="name">Sale Pharmacy Rule</field>
            <field name="model_id" ref="model_sale_pharmacy"/>
            <field name="domain_force">[( 'name', '=', 'name' )]</field>
            <field name="groups" eval="[(4, ref('practical_archi.group_admin_sale_pharmacy'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
        </record>
    </data>
</odoo>