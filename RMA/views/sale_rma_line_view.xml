<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_rma_line_view_list" model="ir.ui.view">
        <field name="name">sale.rma.line.view.list</field>
        <field name="model">sale.rma.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id" domain="[('order_id','=',parent.sale_order)]"/>
                <field name="quantity"/>
                <field name="unit_price"/>
                <field name="to_receive"/>
                <field name="received_qty"/>
            </list>
        </field>
    </record>

    <record id="sale_rma_line_action" model="ir.actions.act_window">
        <field name="name">Sale RMA Line</field>
        <field name="res_model">sale.rma.line</field>
        <field name="view_mode">list</field>
    </record>
</odoo>