<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_product_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.view.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//field[@name='company_id']" position="after">
                <field name="document_ids" widget="many2many_tags" placeholder="Document Tags"/>
            </xpath>
        </field>
    </record>
</odoo>
