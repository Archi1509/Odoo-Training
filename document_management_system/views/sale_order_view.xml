<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_form_view_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.view.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="tags_ids" widget="many2many_tags" placeholder="Tags" />
                <field name="document_ids" widget="many2many_tags" placeholder="Documents"/>
                <field name="show_update_button" />
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_get_document" string="Get Document" type="object" invisible="state  in 'sale'"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after" >
                <button name="action_update_document" string="Update Document" type="object"  invisible="state != 'sale' or show_update_button != True"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="%(document_management_system.action_view_wizard)d"
                        string="Add Products"
                        type="action"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="document_count"/>
            </xpath>
            <xpath expr="//page[@name='customer_signature']" position="after">
                <page string="Documents" >
                    <field name="document_lines">
                        <list editable="bottom">
                            <field name="document_id"/>
                            <field name="product_ids" widget="many2many_tags"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>