<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="document_custom_list_view" model="ir.ui.view">
        <field name="name">document.custom.list.view</field>
        <field name="model">document.custom</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="attachment_id"/>
                <field name="tag_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="document_custom_form_view" model="ir.ui.view">
        <field name="name">document.custom.list.view</field>
        <field name="model">document.custom</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="attachment_id"/>
                        <field name="tag_ids" widget="many2many_tags" />
                     </group>
                </sheet>
            </form>
        </field>
    </record>

   <record id="document_custom_action" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">document.custom</field>
        <field name="view_mode">list,form</field>
   </record>


    <menuitem id="document_custom_main_menu" name="Document Management System"/>
    <menuitem id="document_custom_sub_menu" name="Document"
    parent="document_custom_main_menu"
    action="document_custom_action"/>

</odoo>
