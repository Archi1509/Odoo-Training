<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_document_line_list_view" model="ir.ui.view">
        <field name="name">sale.order.document.line.list.view</field>
        <field name="model">sale.order.document.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="document_id" />
                <field name="product_ids" widget="many2many_tags"/>
                <field name="sale_order_doc_line" />
            </list>
        </field>
    </record>


   <record id="sale_order_document_line_action" model="ir.actions.act_window">
        <field name="name">Document Line</field>
        <field name="res_model">sale.order.document.line</field>
        <field name="view_mode">list</field>
   </record>

    <record id="document_view_search_panel" model="ir.ui.view">
        <field name="name">sale.order.document.line</field>
        <field name="model">sale.order.document.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="sale_order_doc_line"  string="Sale Order" filter_domain="['|','|', ('sale_order_doc_line','ilike',self), ('document_id','ilike',self), ('product_ids','ilike',self)]"/>
            </search>
        </field>
    </record>


    <menuitem id="sale_order_document_line_sub_menu" name="Document Line"
    parent="document_custom_main_menu"
    action="sale_order_document_line_action"/>

</odoo>
