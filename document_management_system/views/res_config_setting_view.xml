<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_sale" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.sale</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="25"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='email_template']" position="after">
                    <setting id="allowed_update" company_dependent="1" help="Allow Update After Order Confirmed">
                        <field name="allowed_update"/>
                    </setting>
            </xpath>
        </field>
    </record>
</odoo>