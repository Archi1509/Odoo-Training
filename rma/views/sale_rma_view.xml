<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_rma_view_form" model='ir.ui.view'>
        <field name="name">sale.rma.view.form</field>
        <field name="model">sale.rma</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_wizard" string="Return" type="object" class="btn-primary"/>
                    <button name="action_open_invoice_wizard" string="Create Invoice" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_show_delivery" class="oe_stat_button" icon="fa-solid fa-truck" >
                            <field string="Delivery" name="picking_ids" widget="statinfo"/>
                        </button>
                        <button type="object" name="action_show_invoice" class="oe_stat_button" icon="fa-file-invoice" >
                            <field string="Invoiced" name="invoice_ids" widget="statinfo"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="rma_id" readonly="True"/>
                        </h1>
                    </div>
                    <group>
                        <field name="team_id" required="True"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="customer_id"/>
                        <field name="sale_order_id"/>
                    </group>
                    <notebook>
                        <page string="Sale Order Line">
                            <field name="sale_rma_line"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_rma_view_list" model="ir.ui.view">
        <field name="name">sale.rma.view.list</field>
        <field name="model">sale.rma</field>
        <field name="arch" type="xml">
            <list>
                <field name="rma_id"/>
                <field name="team_id"/>
                <field name="date"/>
                <field name="sale_order_id"/>
            </list>
        </field>
    </record>

    <record id="sale_rma_action" model="ir.actions.act_window">
        <field name="name">RMA</field>
        <field name="res_model">sale.rma</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sale_rma" name="RMA"/>
    <menuitem id="menu_sale_rma_sub" name="Sale RMA" parent="menu_sale_rma" action="sale_rma_action"/>
</odoo>