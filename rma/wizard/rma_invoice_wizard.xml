<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="rma_invoice_wizard_form" model="ir.ui.view">
            <field name="name">rma.invoice.wizard.form</field>
            <field name="model">rma.invoice.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <notebook>
                            <page string="RMA Invoice Lines">
                                <field name="rma_invoice_wizard_line">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="rma_line_id"/>
                                        <field name="sale_order_quantity"/>
                                        <field name="to_invoice"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <footer>
                        <button name="action_invoice_process" type="object" class="btn-primary" string="Process"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>