<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="author_form_view" model="ir.ui.view">
        <field name="name">author.form.view</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="age"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="author_list_view" model="ir.ui.view">
        <field name="name">author.list.view</field>
        <field name="model">library.author</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="age"/>
            </list>
        </field>
    </record>

    <record id="author_action" model="ir.actions.act_window">
        <field name="name">Author</field>
        <field name="res_model">library.author</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="lms_menu" name="LMS"/>
    <menuitem id="lms_author_menu" name="Author" parent="lms_menu" action="author_action"/>
</odoo>