<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="category_form_view" model="ir.ui.view">
        <field name="name">category.form.view</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="type"/>
                        <field name="book_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="category_list_view" model="ir.ui.view">
        <field name="name">category.list.view</field>
        <field name="model">library.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="type"/>
                <field name="book_ids"/>
            </list>
        </field>
    </record>

    <record id="category_action" model="ir.actions.act_window">
        <field name="name">Category</field>
        <field name="res_model">library.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="lms_menu" name="LMS"/>
    <menuitem id="lms_category_menu" name="Category" parent="lms_menu" action="category_action"/>

</odoo>