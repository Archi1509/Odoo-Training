<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="book_form_view" model="ir.ui.view">
        <field name="name">book.form.view</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form string="Book">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="author_id"/>
                            <field name="isbn"/>
                        </group>
                        <group>
                            <field name="category_id"/>
                            <field name="available_copies"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="book_list_view" model="ir.ui.view">
        <field name="name">book.list.view</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="author_id"/>
                <field name="isbn"/>
                <field name="category_id"/>
                <field name="available_copies"/>
            </list>
        </field>
    </record>

    <record id="book_action" model="ir.actions.act_window">
        <field name="name">Books</field>
        <field name="res_model">library.book</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="lms_menu" name="LMS"/>
    <menuitem id="lms_book_menu" name="Books" parent="lms_menu" action="book_action"/>
</odoo>