<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="approval_team_list_view" model="ir.ui.view">
    		<field name="name">approval.team.list.view</field>
    		<field name="model">approval.team</field>
    		<field name="arch" type="xml">
        		<list>
                    <field name="name" />
        		</list>
    		</field>
    </record>
    <record id="approval_team_form_view" model="ir.ui.view">
    		<field name="name">approval.team.form.view</field>
    		<field name="model">approval.team</field>
    		<field name="arch" type="xml">
        		<form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name" />
                            </group>
                        </group>
                        <notebook>
                            <page string="Approval Levels">
                                <field name="approval_levels">
                                    <list editable="bottom">
                                        <field name="level"/>
                                        <field name="name"/>
                                        <field name="user_ids" widget="many2many_tags"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
        		</form>
    		</field>
    </record>
    <record id="action_approval_team_view" model="ir.actions.act_window">
	  <field name="name">Approval Team</field> <!-- The name shown on UI -->
	  <field name="res_model">approval.team</field> <!-- Model to open -->
	  <field name="view_mode">list,form</field> <!-- Views to open -->
	</record>

	<menuitem id="menu_config" name="Configuration" parent="menu_bista_loan" sequence="2"/>
    <menuitem id="menu_approval_team" name="Approval Teams" parent="menu_config" action="action_approval_team_view"/>
</odoo>
