<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="interest_rate_view_list_view" model="ir.ui.view">
    		<field name="name">interest.rate.view.list.view</field>
    		<field name="model">interest.rate</field>
    		<field name="arch" type="xml">
        		<list decoration-success="is_active == True">
                    <field name="rate" />
                    <field name="interest_date"/>
					<button name="active_rate" string="Activate" type="object" class="btn-primary" confirm="Are You sure You want to activate this rate?" invisible="is_active or interest_date &lt; datetime.date.today().strftime('%Y-%m-%d')" />
                    <field name="is_active" />
        		</list>
    		</field>
    </record>
    <record id="interest_rate_view_form_view" model="ir.ui.view">
    		<field name="name">interest.rate.view.form.view</field>
    		<field name="model">interest.rate</field>
    		<field name="arch" type="xml">
        		<form>
                    <group>
                        <group>
                            <field name="rate" />
                            <field name="interest_date"/>
                            <field name="is_active" invisible="1" />
                        </group>
                    </group>
        		</form>

    		</field>
    </record>
    <record id="action_interest_rate" model="ir.actions.act_window">
	  <field name="name">Rate</field> <!-- The name shown on UI -->
	  <field name="res_model">interest.rate</field> <!-- Model to open -->
	  <field name="view_mode">list,form</field> <!-- Views to open -->
	</record>

	<menuitem id="menu_rate"
		  name="Rate"
		  parent="menu_bista_loan"
          action ="action_interest_rate"
		  sequence="2"/>
</odoo>
