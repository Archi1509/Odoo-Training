<odoo>
    <!-- Creating Groups -->
    <!-- readonly User-->
    <record id="group_sale_order_user_readonly" model="res.groups">
        <field name="name">Sale Order User Readonly</field>
    </record>
    <!-- User can edit what they created -->
    <record id="group_sale_order_user" model="res.groups">
        <field name="name">Sale Order User</field>
    </record>
    <!-- Administrator-->
    <record id="group_sale_order_admin" model="res.groups">
        <field name="name">Sale Order Admin</field>
    </record>

    <!-- record rule for prescription -->
    <record id="bista_sale_order_readonly_rule" model="ir.rule">
        <field name="name">Sale Order Rule</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="domain_force">[( 1, '=', 1 )]</field>
        <field name="groups" eval="[(4, ref('bista_sale_approval.group_sale_order_user_readonly'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="bista_sale_order_user_rule" model="ir.rule">
        <field name="name">Sale Order Rule</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('bista_sale_approval.group_sale_order_user'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>

     <record id="bista_sale_order_admin_rule" model="ir.rule">
        <field name="name">Prescription Rule</field>
        <field name="model_id" ref="model_sale_order"/>
        <field name="domain_force">[( 1, '=', 1 )]</field>
        <field name="groups" eval="[(4, ref('bista_sale_approval.group_sale_order_admin'))]"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>