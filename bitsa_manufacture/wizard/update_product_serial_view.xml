<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="update_product_serial_form_view" model="ir.ui.view">
        <field name="name">update.product.serial.form.view</field>
        <field name="model">update.product.serial</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="operation_type" widget="radio"/>
                        </group>
                        <group>
                            <field name="upload_file" widget="binary" filename="filename"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Replace Products" invisible="operation_type != 'replace_product'">
                            <field name="replace_product_read_file_ids">
                                <list decoration-danger="state != 'draft'">
                                    <field name="mo_number_id"/>
                                    <field name="current_product"/>
                                    <field name="new_product"/>
                                    <field name="state" />
                                </list>
                            </field>
                        </page>
                        <page string="Replace Serial" invisible="operation_type != 'update_serial'">
                            <field name="replace_serial_read_file_ids">
                                <list>
                                    <field name="mo_number_id"/>
                                    <field name="product_code"/>
                                    <field name="old_serial"/>
                                    <field name="new_serial"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button name="read_product_file" type="object" string="Read File" invisible="operation_type != 'replace_product'"/>
                    <button name="read_serial_file" type="object" string="Read File" invisible="operation_type != 'update_serial'"/>
                    <button name="replace_products" type="object" string="Replace Products"  invisible="operation_type != 'replace_product'"/>
                    <button name="replace_serial" type="object" string="Replace Serial"  invisible="operation_type != 'update_serial'"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>