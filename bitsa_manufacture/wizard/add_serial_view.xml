<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="add_serial_view_form" model="ir.ui.view">
        <field name="name">add.serial.form</field>
        <field name="model">add.serial</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="serial_number"/>
                            <field name="product_id"/>
                            <field name="qty" force_save="1" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_serial_number" type="object" class="btn-primary" string="Add Serial Num"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>