<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="stock_picking_form_inh" model="ir.ui.view">
        <field name="name">stock.picking.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='operations']//field[@name='quantity']" position="attributes">
                <attribute name="context">{'default_quantity':sale_id.order_line.process_qty}</attribute>
            </xpath>
        </field>
    </record>
</odoo>