<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mrp_production_form_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="serial_ids" widget="many2many_tags"/>
                <field name="qty"  force_save="1" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="add_serial_number" type="object" string="Add Serial"/>
            </xpath>
            <xpath expr="//field[@name='lot_producing_id']" position="attributes">
                <attribute name="domain">[('id','=',serial_ids)]</attribute>
            </xpath>
        </field>
    </record>
    <record id="mrp_production_list_view_inherit" model="ir.ui.view">
        <field name="name">mrp.production.list.view.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="update_product_and_serial" type="object" string="Update Product/Serial"/>
            </xpath>
        </field>
    </record>
<!--    <menuitem id="menu_sale_rma_sub" name="Sale RMA" parent="menu_sale_rma" action="sale_rma_action"/>-->

</odoo>