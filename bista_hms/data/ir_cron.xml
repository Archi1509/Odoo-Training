<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="appointment_reminder" model="ir.cron">
            <field name="name">Appointment Reminder Today</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._send_appointment_reminder_today()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <record id="weekly_consultation_report" model="ir.cron">
            <field name="name">Weekly Consultation Report</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._weekly_consultation_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="nextcall">2025-03-23 12:00:00</field>
            <field name="active">True</field>
        </record>

        <record id="weekly_cancellation_report" model="ir.cron">
            <field name="name">Weekly Cancellation Report</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._weekly_cancellation_report()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>

        <record id="auto_cancellation" model="ir.cron">
            <field name="name">Auto Cancellation</field>
            <field name="model_id" ref="model_hms_appointment"/>
            <field name="state">code</field>
            <field name="code">model._auto_cancellation()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="send_appointment" model="ir.cron">
            <field name="name">Appointment  Mail Reminder </field>
            <field name="model_id" ref="bista_hms.model_res_doctor"/>
            <field name="state">code</field>
            <field name="code">model.send_appointment_mail()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>