<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="1">
        <record id="get_number_of_patient" model="ir.cron">
            <field name="name">Number of Patient</field>
            <field name="model_id" ref="model_res_patient"/>
            <field name="state">code</field>
            <field name="code">model._get_number_of_patient()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>

        <record id="weekly_visit_action" model="ir.cron">
            <field name="name">Weekly Visit</field>
            <field name="model_id" ref="model_res_patient"/>
            <field name="state">code</field>
            <field name="code">model._weekly_visit_action()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>