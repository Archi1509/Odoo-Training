<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_prescription_report" model="ir.actions.report">
        <field name="name">Prescription</field>
        <field name="model">hms.prescription</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bista_hms.prescription_template</field>
        <field name="report_file">bista_hms.prescription_template</field>
        <field name="print_report_name">('Prescription - %s' % (object.patient_id.name))</field>
        <field name="binding_model_id" ref="model_hms_prescription"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_sale_order_report" model="ir.actions.report">
        <field name="name">Sale Order Test PDF</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bista_hms.sale_order_report_template</field>
        <field name="report_file">bista_hms.sale_order_report_template</field>
        <field name="print_report_name">('Order - %s' % (object.name))</field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
