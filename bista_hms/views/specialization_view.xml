<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="specialization_view_form" model='ir.ui.view'>
        <field name="name">hospital.specialization.form</field>
        <field name="model">hospital.specialization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="des"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="specialization_view_list" model="ir.ui.view">
        <field name="name">hospital.specialization.list</field>
        <field name="model">hospital.specialization</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="des"/>
            </list>
        </field>
    </record>

    <record id="res_specialization_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.specialization</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bista_hms" name="HMS"/>
    <menuitem id="menu_specialization_sub" name="Specialization" parent="menu_bista_hms" action="res_specialization_action"/>

</odoo>