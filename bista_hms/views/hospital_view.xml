<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hospital_view_form" model='ir.ui.view'>
        <field name="name">hospital.hospital.form</field>
        <field name="model">hospital.hospital</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="des"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hospital_view_list" model="ir.ui.view">
        <field name="name">hospital.hospital.list</field>
        <field name="model">hospital.hospital</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="des"/>
            </list>
        </field>
    </record>

    <record id="hospital_action" model="ir.actions.act_window">
        <field name="name">Hospital</field>
        <field name="res_model">hospital.hospital</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bista_hms" name="HMS"/>
    <menuitem id="menu_hospital_sub" name="Hospital" parent="menu_bista_hms" action="hospital_action"/>

</odoo>