<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="line_view_form" model='ir.ui.view'>
        <field name="name">line.view.form</field>
        <field name="model">prescription.line</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="product_id"/>
                            <field name="qty"/>
                            <field name="price_unit"/>
                            <field name="total"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="line_view_list" model="ir.ui.view">
        <field name="name">line.view.list</field>
        <field name="model">prescription.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id"/>
                <field name="qty"/>
                <field name="price_unit" />
                <field name="total"/>
            </list>
        </field>
    </record>

    <record id="line_action" model="ir.actions.act_window">
        <field name="name">PrescriptionLine</field>
        <field name="res_model">prescription.line</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bista_hms" name="HMS"/>

</odoo>