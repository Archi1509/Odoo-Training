<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_doctor_view_form" model='ir.ui.view'>
        <field name="name">doctor.form</field>
        <field name="model">res.doctor</field>
        <field name="arch" type="xml">
            <form string="doctor">
                <header>
                    <button name="action_send_email" type="object" class="btn-primary" string="Send Email"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="specialization"/>
                            <field name="license_no"/>
                            <field name="experience_years"/>
                            <field name="hospital_id"/>
                            <field name="is_emergency_available"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Appointments">
                            <field name="appointment_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_doctor_list" model="ir.ui.view">
        <field name="name">doctor.list</field>
        <field name="model">res.doctor</field>
        <field name="arch" type="xml">
            <list string="Doctors">
                <field name="name"/>
                <field name="email"/>
                <field name="license_no"/>
                <field name="specialization"/>
                <field name="experience_years"/>
                <field name="hospital_id"/>
                <field name="is_emergency_available"/>
            </list>
        </field>
    </record>

    <record id="res_doctor_action" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">res.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bista_hms" name="HMS"/>
    <menuitem id="menu_res_doctor_sub" name="Doctors" parent="menu_bista_hms" action="res_doctor_action"/>

</odoo>