<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="publisher_list_view" model="ir.ui.view">
        <field name="name">publisher.list.view</field>
        <field name="model">publisher.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="publisher_name" />
                <field name="address" />
                <field name="website"/>
            </list>
        </field>
    </record>

    <record id="publisher_form_view" model="ir.ui.view">
        <field name="name">publisher.form.view</field>
        <field name="model">publisher.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="publisher_name" />
                        <field name="address" />
                        <field name="website"/>
                    </group>

                    <notebook>
                        <page string="Books">
                            <group>
                                <field name="publisher_books"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="publisher_action" model="ir.actions.act_window">
        <field name="name">Publishers</field>
        <field name="res_model">publisher.details</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="book_root_menu" name="Book Store Management"/>

    <menuitem id="publisher_menu" name="Publisher"
    parent="book_root_menu"
    action="publisher_action"/>


</odoo>