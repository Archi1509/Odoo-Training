<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="order_list_view" model="ir.ui.view">
        <field name="name">order.list.view</field>
        <field name="model">order.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="order_date" />
                <field name="orders_customer"  />
                <field name="book_orders"/>
            </list>
        </field>
    </record>

        <record id="order_form_view" model="ir.ui.view">
        <field name="name">order.form.view</field>
        <field name="model">order.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="order_date" />
                        <field name="orders_customer"/>

                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="book_orders" />
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <record id="order_action" model="ir.actions.act_window">
        <field name="name">Order</field>
        <field name="res_model">order.details</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="book_root_menu" name="Book Store Management"/>

    <menuitem id="order_menu" name="Order"
    parent="book_root_menu"
    action="order_action"/>

</odoo>
