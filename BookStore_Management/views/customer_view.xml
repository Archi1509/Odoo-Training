<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="customer_list_view" model="ir.ui.view">
        <field name="name">customer.list.view</field>
        <field name="model">customer.details</field>
        <field name="arch" type="xml">
            <list>
                <field name="customer_name" />
                <field name="customer_address" />
                <field name="email"  widget="email" />
                <field name="phone" />

            </list>
        </field>
    </record>

        <record id="customer_form_view" model="ir.ui.view">
        <field name="name">customer.form.view</field>
        <field name="model">customer.details</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Customer">
                        <field name="customer_name" />
                        <field name="customer_address" />
                        <field name="email"  widget="email" />
                        <field name="phone" />
                    </group>
                    <notebook>
                        <page string="Books">
                            <field name="customer_orders" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="customer_action" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">customer.details</field>
        <field name="view_mode">list,form</field>
    </record>
     <menuitem id="book_root_menu" name="Book Store Management"/>

    <menuitem id="customer_menu" name="Customer"
    parent="book_root_menu"
    action="customer_action"/>


</odoo>
